<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>iNetOMeter</RootNamespace>
    <AssemblyName>iNetOMeter</AssemblyName>

    <!-- Application Version and Metadata -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>iNetOMeter</Product>
    <Company>iNetOMeter Open Source Project</Company>
    <Authors>iNetOMeter Contributors</Authors>
    <Description>Lightweight Windows taskbar network speed meter and internet speed test dashboard</Description>
    <Copyright>Copyright © 2026 iNetOMeter Contributors</Copyright>
    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\assets\app.ico" Link="assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\assets\logo.svg" Link="assets\logo.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
